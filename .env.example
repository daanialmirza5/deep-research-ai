# Copy this file to .env and fill in real values. Never commit .env.
# Every variable consumed by any service (frontend, backend, worker, docker-compose) is documented here.

# ============================================================================
# GENERAL
# ============================================================================
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
BACKEND_CORS_ORIGINS=http://localhost:3000

# ============================================================================
# SECURITY / JWT
# ============================================================================
SECRET_KEY=change-me-to-a-long-random-value  # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# OAUTH
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ============================================================================
# POSTGRES
# ============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dra_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deep_research_ai
# Assembled by backend/app/core/config.py from the fields above; override directly if needed.
DATABASE_URL=postgresql+asyncpg://dra_user:change-me@postgres:5432/deep_research_ai

# ============================================================================
# REDIS (Celery broker/result backend + WebSocket pub/sub)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================================
# MINIO (S3-compatible object storage)
# ============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=dra_minio
MINIO_ROOT_PASSWORD=change-me-8chars-min
MINIO_USE_SSL=false
MINIO_BUCKET_DOCUMENTS=dra-documents
MINIO_BUCKET_REPORTS=dra-reports

# ============================================================================
# AI PROVIDERS  (LLMProvider — see ai/llm/, selected via AI_PROVIDER)
# ============================================================================
AI_PROVIDER=openai                  # openai | anthropic | ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ============================================================================
# EMBEDDINGS  (EmbeddingProvider — see ai/embeddings/, selected via EMBEDDING_PROVIDER)
# ============================================================================
EMBEDDING_PROVIDER=bge               # bge (local, default) | openai
EMBEDDING_DIMENSION=1024             # 1024 for bge-large; 1536 for text-embedding-3-small
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# SEARCH TOOLS  (ai/tools/ — optional keys raise rate limits, tools work without them where noted)
# ============================================================================
GOOGLE_SEARCH_API_KEY=               # optional — falls back to DuckDuckGo if unset
GOOGLE_SEARCH_ENGINE_ID=
SEMANTIC_SCHOLAR_API_KEY=            # optional — public rate limit applies if unset
GITHUB_TOKEN=                        # optional — raises GitHub search tool's rate limit

# ============================================================================
# AGENT PIPELINE
# ============================================================================
MAX_REVISION_LOOPS=2                 # cap on Reviewer->Writer / FactChecker->Research cycles
AGENT_TIMEOUT_SECONDS=120

# ============================================================================
# FRONTEND (Next.js — must be prefixed NEXT_PUBLIC_ to reach the browser bundle)
# ============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/ws

# ============================================================================
# MONITORING
# ============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ============================================================================
# PORTS (host-side, used by docker-compose.yml)
# ============================================================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80
POSTGRES_EXPOSED_PORT=5432
REDIS_EXPOSED_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
