# Example TLS-enabled server block for a real deployment — copy to
# docker/nginx/nginx.conf (or mount in place of it) once you have a real
# certificate; see docs/deployment.md's "Enabling HTTPS" section.
#
# Not wired into docker-compose.yml/docker-compose.prod.yml directly: doing
# so here would mean either committing a fake/self-signed cert (misleading —
# looks like TLS is configured when nothing trusts it) or requiring a real
# domain + ACME challenge this repository has no way to complete on its own.
# This file is a correct, ready-to-adapt starting point instead of a
# half-wired default that would silently fail `docker compose up`.
#
# Get a cert however you prefer (certbot, an ACME sidecar, a cloud LB doing
# TLS termination in front of nginx instead) and mount it read-only into the
# nginx container at the paths referenced below.

upstream frontend_upstream {
    server frontend:3000;
}

upstream backend_upstream {
    server backend:8000;
}

server {
    listen 80;
    server_name _;
    # Redirect all plain HTTP to HTTPS instead of serving the app over it.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
